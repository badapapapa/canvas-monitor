# Bootstrap secrets ONLY. Everything else lives in the `config` table so it can
# be rotated with `npm run set-config` instead of a redeploy (SPEC.md section 12).
#
# Something has to hold the key to the box that holds the keys; this is it.

# Local development: a file-backed libSQL database needs no auth token.
TURSO_DATABASE_URL=file:./data/canvas-monitor.db
# Production (Turso):
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# debug | info | warn | error   (default: info)
LOG_LEVEL=info

# There is deliberately NO environment variable that lifts log redaction.
# Redaction is on at every level; the only way off is the --unsafe-log flag,
# which the CLI refuses whenever CI or GITHUB_ACTIONS is set. An env var is
# exactly the thing a workflow file can set, which would make the guarantee
# unenforceable. See DECISIONS.md D-26.

# One-shot bootstrap for `npm run set-config <key> --from-env`.
# CANVAS_TOKEN=
# CANVAS_TOKEN_EXPIRES_AT=2026-11-20T00:00:00Z

# Set by the scheduler so runs can measure queue drift (SPEC.md section 11).
# RUN_SCHEDULED_FOR=2026-08-27T04:00:00Z

# The dashboard's read model (DECISIONS.md D-65): a SEPARATE Turso database.
# The write token is the sync's; the read-only token is the dashboard's and is
# only here so `npm run readmodel -- verify` can prove the separation.
# READMODEL_DATABASE_URL=libsql://<readmodel-db>-<org>.turso.io
# READMODEL_WRITE_TOKEN=
# READMODEL_READ_TOKEN=
